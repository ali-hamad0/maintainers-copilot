# =============================================================================
# .env.example — copy to .env and fill in real values before `docker compose up`
#
# RULE (CLAUDE.md §6): this file holds ONLY the Vault root token and
# non-secret tunables.  ALL secrets (DB password, API keys, JWT key, MinIO
# creds, tracing key) are stored in Vault and injected at API startup.
#
# Secrets are bootstrapped by scripts/vault-bootstrap.sh on first boot.
# To set a real key:
#   docker exec <vault-container> vault kv put secret/gemini api_key="AIza..."
# =============================================================================

# ── Vault ─────────────────────────────────────────────────────────────────────
# The ONLY secret that lives in .env.  Used by api, migrate, and vault-bootstrap.
VAULT_ROOT_TOKEN=dev-root-token
VAULT_ADDR=http://vault:8200

# ── Database (non-secret connection params; password is in Vault kv/db) ───────
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_NAME=maintainers_copilot

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (non-secret endpoint; creds are in Vault kv/minio) ─────────────────
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=maintainers-copilot

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── LLM / ML (API key is in Vault kv/gemini) ─────────────────────────────────
LLM_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ── Tracing (API key is in Vault kv/tracing) ─────────────────────────────────
TRACING_BACKEND=langsmith
LANGSMITH_PROJECT=maintainers-copilot

# ── Service URLs ──────────────────────────────────────────────────────────────
MODELSERVER_BASE_URL=http://modelserver:8001

# ── Compose port overrides (optional) ────────────────────────────────────────
# Uncomment and change if the default ports conflict with other local services.
# API_PORT=8000
# CHATBOT_PORT=8501
# WIDGET_PORT=3000
# HOST_PORT=8080
# MODELSERVER_PORT=8001
# VAULT_PORT=8200
# DB_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
