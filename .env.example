# Vault — Required. Get from bootcamp materials or Vault dev mode
VAULT_ROOT_TOKEN=s.xxxxxxxxxxxxxxxx

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/maintainers_copilot
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=maintainers_copilot

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_URL=http://minio:9000
MINIO_CONSOLE_URL=http://minio:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=maintainers-copilot

# API Service
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000

# Chatbot Service (Streamlit)
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8501

# Widget Service (Static)
WIDGET_HOST=0.0.0.0
WIDGET_PORT=3000
WIDGET_BASE_URL=http://widget:3000

# ModelServer Service
MODELSERVER_HOST=0.0.0.0
MODELSERVER_PORT=8001
MODELSERVER_BASE_URL=http://modelserver:8001

# Host App (Demo)
HOST_PORT=8080
HOST_BASE_URL=http://host:8080

# Vault Service
VAULT_HOST=vault
VAULT_PORT=8200
VAULT_ADDR=http://vault:8200

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-from-vault
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# LLM Provider (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Embedding Model
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Tracing Backend
TRACING_BACKEND=langsmith
LANGSMITH_API_KEY=ls_xxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=maintainers-copilot

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
DEBUG=false

# CORS (widget allowlisting handled via database, not env)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security
GITLEAKS_ENABLED=true
